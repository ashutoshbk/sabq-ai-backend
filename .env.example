# Copy this file to .env and edit. If OPENAI_API_KEY is already set as an
# environment variable in your conda env, you can leave it commented out.
# OPENAI_API_KEY=sk-...

# Models (swap without touching code). Check they exist for your key with
#   GET /health/openai
CHAT_MODEL=gpt-5.4-nano
TRENDS_MODEL=gpt-5.4-mini

# Optional: low | medium | high (leave empty to use the model default).
# Lower = faster and cheaper on reasoning models.
REASONING_EFFORT=

# Output token limits. Reasoning models count their hidden thinking tokens
# here too, so do not set these too small.
CHAT_MAX_OUTPUT_TOKENS=1500
TRENDS_MAX_OUTPUT_TOKENS=8000

# ---- Research feed (five topics) ----
# Maximum items kept per topic
TRENDS_PER_TOPIC=10
# How many topic searches run at the same time
TRENDS_SEARCH_CONCURRENCY=3
# Results are saved here so "only new items" still works after a restart.
# Relative to the project folder. Leave empty to keep results in memory only.
TRENDS_STORE_PATH=data/trends_store.json
# Results older than this count as stale. While automatic refresh is on, this is
# raised to cover one refresh period (a day or a week) plus 2 hours automatically.
TRENDS_CACHE_TTL_MINUTES=1440

# ---- Automatic refresh: the server researches by itself on a schedule ----
# The server must be running at that time.
TRENDS_AUTO_REFRESH_ENABLED=true
# daily | weekly
TRENDS_REFRESH_FREQUENCY=weekly
# Used when weekly: monday ... sunday
TRENDS_REFRESH_DAY=monday
TRENDS_REFRESH_TIME=06:00
TRENDS_REFRESH_TIMEZONE=Asia/Dubai
# true = also run a refresh each time the server starts
TRENDS_REFRESH_ON_STARTUP=false

# ---- Horizon Scanning Agent (reads the stored research, writes scored trend cards) ----
HORIZON_MODEL=gpt-5.4-mini
HORIZON_MAX_OUTPUT_TOKENS=6000
# Most trend cards written per topic (1 to 10)
HORIZON_CARDS_PER_TOPIC=5
# Dated research items older than this many months are ignored
HORIZON_MAX_AGE_MONTHS=24
# Cards are saved here. Relative to the project folder. Empty = memory only.
HORIZON_STORE_PATH=data/horizon_store.json
# true = run the agent right after each automatic research refresh
HORIZON_AUTO_RUN_AFTER_REFRESH=true
# Clarifying questions in the on-demand conversation before it just runs (0 = never ask)
HORIZON_MAX_QUESTIONS=2

# ---- Benchmarking Agent (finds published indicator figures online) ----
BENCHMARK_MODEL=gpt-5.4-mini
BENCHMARK_MAX_OUTPUT_TOKENS=5000
# Results are saved here. Relative to the project folder. Empty = memory only.
BENCHMARK_STORE_PATH=data/benchmark_store.json
# true = check after each automatic feed refresh (it only searches when the results are due)
BENCHMARK_AUTO_RUN_AFTER_REFRESH=true
# Search again when the saved results are older than this many days
BENCHMARK_REFRESH_DAYS=90

# OpenAI client timeout in seconds (research searches can take a while)
OPENAI_TIMEOUT_SECONDS=180

# CORS: comma-separated origins the front-end runs on, or * for all (POC only)
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO

# --- Best Practices Curator (Agent 3) ---
BEST_PRACTICES_MODEL=gpt-5.4-mini
BEST_PRACTICES_MAX_OUTPUT_TOKENS=6000
BEST_PRACTICES_STORE_PATH=data/best_practices_store.json
# Most practices per gap, and clarifying questions before it just runs
BEST_PRACTICES_MAX_CARDS=5
BEST_PRACTICES_MAX_QUESTIONS=2
BEST_PRACTICES_MAX_CUSTOM_GAPS=20

# A figure this many years old gets an "out of date" note
BENCHMARK_STALE_YEARS=3
