# Copy this file to .env and edit. If OPENAI_API_KEY is already set as an
# environment variable in your conda env, you can leave it commented out.
# OPENAI_API_KEY=sk-...

# Models (swap without touching code). Check they exist for your key with
#   GET /health/openai
CHAT_MODEL=gpt-5.4-nano
TRENDS_MODEL=gpt-5.4-mini

# Optional: low | medium | high (leave empty to use the model default).
# Lower = faster and cheaper on reasoning models.
REASONING_EFFORT=

# Output token limits. Reasoning models count their hidden thinking tokens
# here too, so do not set these too small.
CHAT_MAX_OUTPUT_TOKENS=1500
TRENDS_MAX_OUTPUT_TOKENS=8000

# ---- Research feed (five topics) ----
# Maximum items kept per topic
TRENDS_PER_TOPIC=10
# How many topic searches run at the same time
TRENDS_SEARCH_CONCURRENCY=3
# Results are saved here so "only new items" still works after a restart.
# Relative to the project folder. Leave empty to keep results in memory only.
TRENDS_STORE_PATH=data/trends_store.json
# Results older than this count as stale. While automatic refresh is on, this is
# raised to cover one refresh period (a day or a week) plus 2 hours automatically.
TRENDS_CACHE_TTL_MINUTES=1440

# ---- Automatic refresh: the server researches by itself on a schedule ----
# The server must be running at that time.
TRENDS_AUTO_REFRESH_ENABLED=true
# daily | weekly
TRENDS_REFRESH_FREQUENCY=weekly
# Used when weekly: monday ... sunday
TRENDS_REFRESH_DAY=monday
TRENDS_REFRESH_TIME=06:00
TRENDS_REFRESH_TIMEZONE=Asia/Dubai
# true = also run a refresh each time the server starts
TRENDS_REFRESH_ON_STARTUP=false

# OpenAI client timeout in seconds (research searches can take a while)
OPENAI_TIMEOUT_SECONDS=180

# CORS: comma-separated origins the front-end runs on, or * for all (POC only)
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO
